resource "azurerm_resource_group" "res-0" {
  location = "eastus"
  name     = "MyResourceGroup"
}
resource "azurerm_ssh_public_key" "res-1" {
  location            = "eastus"
  name                = "myvirtualmachine-ssh-key"
  public_key          = "ssh-rsa  generated-by-azure"
  resource_group_name = azurerm_resource_group.res-0.name
}
resource "azurerm_linux_virtual_machine" "res-2" {
  admin_username        = "azureuser"
  location              = "eastus"
  name                  = "MyVirtualMachine"
  network_interface_ids = [azurerm_network_interface.res-4.id]
  os_managed_disk_id    = "/subscriptions/3f84c873-6292-45f2-b495-de2bbeff1646/resourceGroups/MyResourceGroup/providers/Microsoft.Compute/disks/MyVirtualMachine_disk1_aad2e4c77d3c4efbb0827c4ee539b012"
  resource_group_name   = azurerm_resource_group.res-0.name
  secure_boot_enabled   = true
  size                  = "Standard_D2als_v7"
  vtpm_enabled          = true
  additional_capabilities {
  }
  admin_ssh_key {
    public_key = "ssh-rsa  generated-by-azure"
    username   = "azureuser"
  }
  boot_diagnostics {
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Premium_LRS"
  }
  source_image_reference {
    offer     = "ubuntu-24_04-lts"
    publisher = "canonical"
    sku       = "server"
    version   = "latest"
  }
}
resource "azurerm_network_ddos_protection_plan" "res-3" {
  location            = "eastus"
  name                = "MyDdoSProtectionPlan"
  resource_group_name = azurerm_resource_group.res-0.name
}
resource "azurerm_network_interface" "res-4" {
  accelerated_networking_enabled = true
  location                       = "eastus"
  name                           = "myvirtualmachine628"
  resource_group_name            = azurerm_resource_group.res-0.name
  ip_configuration {
    name                          = "ipconfig1"
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.res-8.id
    subnet_id                     = azurerm_subnet.res-13.id
  }
}
resource "azurerm_network_interface_security_group_association" "res-5" {
  network_interface_id      = azurerm_network_interface.res-4.id
  network_security_group_id = azurerm_network_security_group.res-6.id
}
resource "azurerm_network_security_group" "res-6" {
  location            = "eastus"
  name                = "MyVirtualMachine-nsg"
  resource_group_name = azurerm_resource_group.res-0.name
}
resource "azurerm_network_security_rule" "res-7" {
  access                      = "Allow"
  destination_address_prefix  = "*"
  destination_port_range      = "22"
  direction                   = "Inbound"
  name                        = "SSH"
  network_security_group_name = "MyVirtualMachine-nsg"
  priority                    = 300
  protocol                    = "Tcp"
  resource_group_name         = azurerm_resource_group.res-0.name
  source_address_prefix       = "*"
  source_port_range           = "*"
  depends_on = [
    azurerm_network_security_group.res-6,
  ]
}
resource "azurerm_public_ip" "res-8" {
  allocation_method   = "Static"
  domain_name_label   = "mypublicdnsade"
  location            = "eastus"
  name                = "MyPublicIPAddress"
  resource_group_name = azurerm_resource_group.res-0.name
  zones               = ["1", "2", "3"]
}
resource "azurerm_public_ip" "res-9" {
  allocation_method   = "Static"
  location            = "eastus"
  name                = "MyVirtualMachine-ip"
  resource_group_name = azurerm_resource_group.res-0.name
}
resource "azurerm_virtual_network" "res-10" {
  address_space       = ["10.0.0.0/16"]
  location            = "eastus"
  name                = "MyVirtualNetwork"
  resource_group_name = azurerm_resource_group.res-0.name
  ddos_protection_plan {
    enable = true
    id     = azurerm_network_ddos_protection_plan.res-3.id
  }
}
resource "azurerm_subnet" "res-11" {
  address_prefixes                = ["10.0.0.0/24"]
  default_outbound_access_enabled = false
  name                            = "default"
  resource_group_name             = azurerm_resource_group.res-0.name
  virtual_network_name            = "MyVirtualNetwork"
  depends_on = [
    azurerm_virtual_network.res-10,
  ]
}
resource "azurerm_virtual_network" "res-12" {
  address_space       = ["172.16.0.0/16"]
  location            = "eastus"
  name                = "vnet-eastus-1"
  resource_group_name = azurerm_resource_group.res-0.name
}
resource "azurerm_subnet" "res-13" {
  address_prefixes     = ["172.16.0.0/24"]
  name                 = "snet-eastus-1"
  resource_group_name  = azurerm_resource_group.res-0.name
  virtual_network_name = "vnet-eastus-1"
  depends_on = [
    azurerm_virtual_network.res-12,
  ]
}
resource "azurerm_monitor_metric_alert" "res-14" {
  name                = "MyDdosAlert"
  resource_group_name = azurerm_resource_group.res-0.name
  scopes              = [azurerm_public_ip.res-8.id]
  criteria {
    aggregation      = "Maximum"
    metric_name      = "IfUnderDDoSAttack"
    metric_namespace = "Microsoft.Network/publicIPAddresses"
    operator         = "GreaterThanOrEqual"
    threshold        = 1
  }
}
