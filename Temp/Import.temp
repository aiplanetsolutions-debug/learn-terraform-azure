# run this in bash to import manual config: terraform plan -generate-config-out="generated_manual_resources.tf"

import {
  # Define what resource type and local name you want
  to = azurerm_virtual_network_gateway_connection.on_prem_office_manual

  # Paste the exact Azure Resource ID you copied from Step 1
